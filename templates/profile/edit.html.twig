{% extends 'base.html.twig' %}

{% block title %}Modifier le profil - Wakatta!
{% endblock %}

{% block body %}
	<div data-controller="delete-account edit-profile">

		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center gap-2">
				<form data-edit-profile-target="usernameForm" method="post" action="{{ path('app_profile_edit_username') }}">
					{{ form_start(usernameForm) }}
					{{ form_widget(usernameForm.username, {'attr': {
							'class': 'text-3xl font-bold font-title text-bleu-aiiro bg-transparent border-0 outline-none p-0',
        					'readonly': true,
							'data-edit-profile-target': 'usernameInput',
							'data-action': 'blur->edit-profile#submitUsername keydown.enter->edit-profile#submitUsername input->edit-profile#resizeUsernameInput'}}) }}

					{{ form_end(usernameForm) }}
				</form>
				<button type="button" data-action="click->edit-profile#toggleUsernameEdit" class="cursor-pointer">
					<svg data-edit-profile-target="editIcon" width="18" height="18" viewbox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M2 18H16C17.1 18 18 17.1 18 16V9H16V16H2V2H9V0H2C0.9 0 0 0.9 0 2V16C0 17.1 0.9 18 2 18Z" fill="black"/>
						<path d="M4.00002 10V13C4.00002 13.55 4.45002 14 5.00002 14H8.00002C8.27002 14 8.52002 13.89 8.71002 13.71L17.71 4.71001C17.8027 4.6175 17.8763 4.50761 17.9264 4.38664C17.9766 4.26566 18.0025 4.13598 18.0025 4.00501C18.0025 3.87404 17.9766 3.74436 17.9264 3.62339C17.8763 3.50241 17.8027 3.39253 17.71 3.30001L14.71 0.300012C14.6175 0.207309 14.5076 0.133761 14.3866 0.0835798C14.2657 0.0333983 14.136 0.00756836 14.005 0.00756836C13.874 0.00756836 13.7444 0.0333983 13.6234 0.0835798C13.5024 0.133761 13.3925 0.207309 13.3 0.300012L4.29002 9.29001C4.19734 9.38345 4.12401 9.49427 4.07425 9.61611C4.02448 9.73794 3.99926 9.86841 4.00002 10ZM14 2.41001L15.59 4.00001L14.5 5.09001L12.91 3.50001L14 2.41001ZM6.00002 10.41L11.5 4.91001L13.09 6.50001L7.59002 12H6.00002V10.41Z" fill="black"/>
					</svg>
					<svg data-edit-profile-target="checkIcon" class="hidden" width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="20 6 9 17 4 12"/>
					</svg>
				</button>
			</div>

			<button type="button" data-action="click->delete-account#open" class="text-sm font-bold text-encre rounded-lg px-4 border-4 border-encre text-center flex items-center justify-center" style="background-color: #A63328; height: 56px;">
				Supprimer<br>le compte
			</button>
		</div>

		<p class="text-sm text-encre/60 mb-6">{{ app.user.email }}</p>

		<form data-edit-profile-target="editForm" data-action="submit->edit-profile#submitEditForm" method="post" action="{{ path('app_profile_edit_submit') }}">
			{{ form_start(editProfileForm) }}

			<div class="mb-3 w-full">
				{{ form_label(editProfileForm.email.first, 'Nouveau mail', {'label_attr': {'class': 'label-form'}}) }}
				{{ form_widget(editProfileForm.email.first, {'attr': {'class': 'input-form'}}) }}
				{{ form_errors(editProfileForm.email.first) }}
			</div>

			<div class="mb-3 w-full">
				{{ form_label(editProfileForm.email.second, 'Confirmer nouveau mail', {'label_attr': {'class': 'label-form'}}) }}
				{{ form_widget(editProfileForm.email.second, {'attr': {'class': 'input-form'}}) }}
				{{ form_errors(editProfileForm.email) }}
			</div>

			<div class="mb-3 w-full">
				{{ form_label(editProfileForm.plainPassword.first, 'Changer mot de passe', {'label_attr': {'class': 'label-form'}}) }}
				{{ form_widget(editProfileForm.plainPassword.first, {'attr': {'class': 'input-form'}}) }}
				{{ form_errors(editProfileForm.plainPassword.first) }}
			</div>

			<div class="mb-6 w-full">
				{{ form_label(editProfileForm.plainPassword.second, 'Confirmer nouveau mot de passe', {'label_attr': {'class': 'label-form'}}) }}
				{{ form_widget(editProfileForm.plainPassword.second, {'attr': {'class': 'input-form'}}) }}
				{{ form_errors(editProfileForm.plainPassword) }}
			</div>

			{{ form_widget(editProfileForm.currentPassword, {'attr': {'class': 'hidden', 'data-edit-profile-target': 'currentPasswordInput'}}) }}

			<button type="submit" class="btn w-full">Valider</button>

			{{ form_end(editProfileForm) }}
		</form>

		{# Modal mot de passe actuel #}
		<div data-edit-profile-target="backdrop" data-action="click->edit-profile#closeModal" class="hidden fixed inset-0 bg-encre/50 z-40"></div>

		<div data-edit-profile-target="modal" class="hidden opacity-0 scale-95 transition-all duration-200 fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-50 bg-white rounded-lg shadow-lg p-6 w-80">
			<p class="text-encre font-semibold text-center mb-4">
				Veuillez entrer votre mot de passe actuel pour confirmer
			</p>

			<div class="mb-4 w-full">
				<input type="password" data-edit-profile-target="confirmPasswordInput" placeholder="Mot de passe actuel..." class="input-form">
				<p data-edit-profile-target="modalError" class="hidden text-rouge-torii text-sm font-semibold mt-2"></p>
			</div>

			<button type="button" data-action="click->edit-profile#confirmPassword" class="btn w-full">
				Confirmer
			</button>
		</div>

		{# Backdrop delete-account #}
		<div data-delete-account-target="backdrop" data-action="click->delete-account#close" class="hidden fixed inset-0 bg-encre/50 z-40"></div>

		{# Modal delete-account #}
		<div data-delete-account-target="modal" class="hidden opacity-0 scale-95 transition-all duration-200 fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-50 bg-white rounded-lg shadow-lg p-6 w-80">

			<div data-delete-account-target="step1">
				<p class="text-encre font-semibold text-center mb-6">
					Voulez-vous supprimer votre compte ? Cette action est irréversible.
				</p>
				<div class="flex gap-3">
					<button type="button" data-action="click->delete-account#close" class="flex-1 border-2 border-bleu-aiiro rounded-lg py-2 text-encre">
						Non
					</button>
					<button type="button" data-action="click->delete-account#goToStep2" class="flex-1 bg-rouge-torii text-white rounded-lg py-2">
						Oui
					</button>
				</div>
			</div>

			<div data-delete-account-target="step2" class="hidden">
				<p class="text-encre font-semibold text-center mb-2">
					Dernière étape
				</p>
				<p class="text-encre/70 text-sm text-center mb-5">
					Toute ta progression (XP, historique) sera définitivement perdue.
				</p>

				<form method="post" action="{{ path('app_profile_delete') }}">
					{{ form_start(deleteAccountForm) }}

					<label class="flex items-start gap-2 mb-5 text-sm text-encre bg-beige-washi rounded-lg p-3 border border-gris-pierre">
						<input type="checkbox" data-delete-account-target="checkbox" data-action="change->delete-account#toggleSubmit" class="mt-1.5">
						J'ai bien compris que cette action est irréversible
					</label>

					<div class="mb-5 w-full">
						{{ form_label(deleteAccountForm.password, 'Mot de passe', {'label_attr': {'class': 'label-form'}}) }}
						{{ form_widget(deleteAccountForm.password, {'attr': {'class': 'input-form', 'placeholder': 'Mot de passe...'}}) }}
						{{ form_errors(deleteAccountForm.password) }}
					</div>

					<button type="submit" data-delete-account-target="submitBtn" disabled class="w-full text-white rounded-lg py-2 font-semibold disabled:opacity-40 disabled:cursor-not-allowed" style="background-color: #A63328;">
						Valider la suppression
					</button>

					{{ form_end(deleteAccountForm) }}
				</form>
			</div>

		</div>

	</div>
{% endblock %}
