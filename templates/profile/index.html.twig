{% extends 'base.html.twig' %}

{% block title %}Profil - Wakatta!
{% endblock %}

{% block body %}
	<div class="flex items-center justify-between mb-4">
		<h1 class="text-3xl font-bold font-title text-bleu-aiiro">{{ app.user.username }}</h1>
		<a href="{{ path('app_profile_edit') }}" class="text-sm font-semibold text-white bg-rouge-torii rounded-lg px-4 text-center flex items-center justify-center" style="height: 56px;">
			Modifier<br>Profil
		</a>
	</div>

	<section class="mb-8">
		<h2 class="titre-section mb-2">Progression globale</h2>
		{% include 'dashboard/_progress_bar.html.twig' with {
        label: 'Niveau ' ~ globalProgression.level,
        current: globalProgression.xpCurrentLevel,
        needed: globalProgression.xpNextLevel,
        percent: globalProgression.percent
    } %}
	</section>

	<section class="space-y-4">
		{% for module in modules %}
			<div class="block bg-white rounded-lg overflow-hidden shadow-sm border border-gris-pierre">
				<div class="h-32 bg-gris-pierre flex items-center justify-center text-encre/40 text-sm">
					Image du module
				</div>
				<div class="p-4">
					<h3 class="font-semibold text-encre mb-2">{{ module.label }}</h3>
					{% include 'dashboard/_progress_bar.html.twig' with {
                    label: 'Niv. ' ~ module.progression.level,
                    current: module.progression.xpCurrentLevel,
                    needed: module.progression.xpNextLevel,
                    percent: module.progression.percent
                } %}
				</div>
			</div>
		{% endfor %}
	</section>
{% endblock %}
